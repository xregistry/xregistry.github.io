---
layout: null
permalink: /blog/feed.xml
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | append: " Blog" | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ '/blog/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml" />
  <link href="{{ '/blog/' | absolute_url }}" rel="alternate" type="text/html" />
  <id>{{ '/blog/' | absolute_url }}</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  {% assign articles = site.articles | sort: "series_order" %}
  {% for article in articles %}
  <entry>
    <title>{{ article.title | xml_escape }}</title>
    <link href="{{ article.url | absolute_url }}" rel="alternate" type="text/html" />
    <id>{{ article.url | absolute_url }}</id>
    <updated>{{ article.drafted | date_to_xmlschema }}</updated>
    <summary type="html">{{ article.description | xml_escape }}</summary>
  </entry>
  {% endfor %}
</feed>